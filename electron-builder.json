{
  "appId": "com.mkttools.desktop",
  "productName": "MKT Tools Desktop",
  "copyright": "Copyright © 2026 MKT Tools",
  "npmRebuild": false,
  "artifactName": "MKT-Tools-Desktop-Setup-${version}.${ext}",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "build/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone",
      "filter": ["**/*"]
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "anhvult911",
    "repo": "marketing-tool-desktop",
    "releaseType": "release"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MKT Tools",
    "deleteAppDataOnUninstall": false
  }
}
